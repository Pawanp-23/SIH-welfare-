# Optional. Enables LLM synthesis over the SOP retrieval layer.
# Without it, retrieval still returns the SOP text and its citation —
# there is deliberately no LLM on the critical path.
GEMINI_API_KEY=""

# Optional. Overrides the default model used for that synthesis.
GEMINI_MODEL="gemini-2.0-flash"

# Optional. Signing secret for session tokens. If unset, a random secret is
# generated per process, which means a restart invalidates existing sessions —
# the safe default for a system holding welfare data.
SAHARA_SECRET=""

# Optional. Key for the deterministic HMAC pseudonyms shown to command roles.
SAHARA_PSEUDONYM_KEY=""

# Optional. Database path. Defaults to ./.data/sahara.db
SAHARA_DB=""
